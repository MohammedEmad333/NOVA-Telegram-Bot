# Create a bot via Telegram's official BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_with_real_token
# Only these Telegram numeric user IDs can use the bot (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=123456789
# Standard Telegram Bot API limit is 50 MB; NOVA uses a 47 MiB safety cap.
MAX_VIDEO_MB=47
DOWNLOAD_TIMEOUT_SECONDS=900
