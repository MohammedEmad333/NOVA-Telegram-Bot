# Telegram bot token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_with_real_token
# Only these Telegram numeric user IDs can use NOVA (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=123456789

# Telegram API application credentials from https://my.telegram.org
# These are free. Keep both values private and never commit the real values.
TELEGRAM_API_ID=replace_with_api_id
TELEGRAM_API_HASH=replace_with_api_hash

# Local Bot API mode: supports local file uploads up to Telegram's 2 GB limit.
# NOVA starts with a conservative 500 MiB application cap.
MAX_VIDEO_MB=500
DOWNLOAD_TIMEOUT_SECONDS=1800
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=1800
